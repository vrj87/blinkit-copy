# Pooled connection (serverless runtime — Neon pooled URL or Supabase transaction pooler port 6543)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct connection (migrations only — Neon direct URL or Supabase port 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
GROQ_API_KEY=""
GROQ_API_KEYS_URL="https://console.groq.com/keys"
OPENAI_API_KEY=""
N8N_WEBHOOK_SECRET="blinkit-mvp-webhook-prod"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_COLLECT_URL="http://localhost:3001"
# Netlify production (see docs/NETLIFY.md)
# GROQ_API_KEY=           # required for runtime LLM + optional seed
# SKIP_LLM_SEED=true      # optional: skip Groq during prisma seed
# FORCE_DB_SEED=true      # optional: wipe and re-seed even if users exist
